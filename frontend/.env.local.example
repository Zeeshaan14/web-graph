NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Only needed once the backend has API_KEY set (see backend/api/config.py --
# unset by default, so local dev works with neither of these set). NOTE:
# NEXT_PUBLIC_* vars are baked into the client bundle and visible to
# anyone using browser devtools -- this deters casual/automated abuse of
# the bare API, it is NOT a secret from someone inspecting this site's
# own network requests.
NEXT_PUBLIC_API_KEY=
